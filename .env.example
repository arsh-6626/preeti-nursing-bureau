# --- Database (PostgreSQL 14+) ---
# Development database (docker: see README "Local setup")
DATABASE_URL="postgresql://pnb:pnb_dev_password@localhost:5544/pnb?schema=public"
# Separate database used by automated tests. It is TRUNCATED by the test suite.
TEST_DATABASE_URL="postgresql://pnb:pnb_dev_password@localhost:5544/pnb_test?schema=public"

# --- Security ---
# Random secret used to hash client fingerprints for rate limiting.
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL of the site (used in documentation and future integrations).
APP_URL="http://localhost:3000"

# --- First administrator (used once by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-to-12+-chars-1"

# --- Optional fallbacks for contact details ---
# Normally set in Admin > Settings. These are only used when the setting is empty.
# NEXT_PUBLIC_CONTACT_PHONE="+91 9xxxxxxxxx"
# NEXT_PUBLIC_CONTACT_WHATSAPP="+91 9xxxxxxxxx"

# --- Optional: password hashing cost (default 12; tests use 4) ---
# BCRYPT_COST=12
